#VRML_SIM R2025a utf8

WorldInfo {
  info [
    "Water-shooting robot simulation."
    "A supervisor robot sweeps a two-axis turret (yaw + pitch) and fires"
    "water droplets that follow ballistic trajectories into a pool of water."
    "The pool is a Fluid node; droplets are spawned by the supervisor controller."
  ]
  title "Water Shooting Robot"
  gravity 9.81
  basicTimeStep 8
  coordinateSystem "ENU"
}

Viewpoint {
  orientation 0.8906 -0.455 0.0 1.145
  position -1.5 -4.5 2.5
}

Background {
  skyColor [
    0.5 0.7 1.0
  ]
}

DirectionalLight {
  direction -0.5 -0.5 -1
  intensity 1.5
  castShadows TRUE
}

# Floor -----------------------------------------------------------------------
Solid {
  name "floor"
  translation 0 0 -0.05
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.55 0.57 0.6
        roughness 0.9
        metalness 0.0
      }
      geometry Box {
        size 12 12 0.1
      }
    }
  ]
  boundingObject Box {
    size 12 12 0.1
  }
  physics Physics {
  }
}

# Pool walls (unique names!) --------------------------------------------------
Solid {
  name "pool_wall_north"
  translation 1.5 0.825 0.225
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.7 0.72 0.75
        roughness 0.8
      }
      geometry Box {
        size 1.7 0.05 0.45
      }
    }
  ]
  boundingObject Box {
    size 1.7 0.05 0.45
  }
  physics Physics {
  }
}
Solid {
  name "pool_wall_south"
  translation 1.5 -0.825 0.225
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.7 0.72 0.75
        roughness 0.8
      }
      geometry Box {
        size 1.7 0.05 0.45
      }
    }
  ]
  boundingObject Box {
    size 1.7 0.05 0.45
  }
  physics Physics {
  }
}
Solid {
  name "pool_wall_east"
  translation 2.325 0 0.225
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.7 0.72 0.75
        roughness 0.8
      }
      geometry Box {
        size 0.05 1.7 0.45
      }
    }
  ]
  boundingObject Box {
    size 0.05 1.7 0.45
  }
  physics Physics {
  }
}
Solid {
  name "pool_wall_west"
  translation 0.675 0 0.225
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.7 0.72 0.75
        roughness 0.8
      }
      geometry Box {
        size 0.05 1.7 0.45
      }
    }
  ]
  boundingObject Box {
    size 0.05 1.7 0.45
  }
  physics Physics {
  }
}

# Water volume (Fluid node) ---------------------------------------------------
Fluid {
  name "water"
  translation 1.5 0 0.15
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.1 0.35 0.85
        transparency 0.55
        roughness 0.15
        metalness 0.0
      }
      geometry Box {
        size 1.6 1.6 0.3
      }
    }
  ]
  boundingObject Box {
    size 1.6 1.6 0.3
  }
  density 1000
  viscosity 0.001
}

# Robot -----------------------------------------------------------------------
Robot {
  name "water_shooter_robot"
  translation -1 0 0
  supervisor TRUE
  controller "water_shooter"
  children [
    # Fixed base
    Solid {
      name "base"
      translation 0 0 0.15
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.25 0.25 0.3
            roughness 0.6
            metalness 0.4
          }
          geometry Cylinder {
            height 0.3
            radius 0.15
          }
        }
      ]
      boundingObject Cylinder {
        height 0.3
        radius 0.15
      }
      physics Physics {
        mass 5
      }
    }
    # Yaw joint (axis Z): sweeps the turret left/right
    HingeJoint {
      jointParameters HingeJointParameters {
        anchor 0 0 0.3
        axis 0 0 1
      }
      device [
        RotationalMotor {
          name "yaw_motor"
          minPosition -2.6
          maxPosition 2.6
          maxVelocity 3.14
        }
      ]
      endPoint Solid {
        name "turret"
        translation 0 0 0.3
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.85 0.45 0.1
              roughness 0.5
              metalness 0.3
            }
            geometry Cylinder {
              height 0.06
              radius 0.09
            }
          }
          # Pitch joint (axis Y): tilts the nozzle up/down
          # negative angle => nozzle points upward (see controller)
          HingeJoint {
            jointParameters HingeJointParameters {
              anchor 0 0 0.12
              axis 0 1 0
            }
            device [
              RotationalMotor {
                name "pitch_motor"
                minPosition -1.2
                maxPosition 1.2
                maxVelocity 2.0
              }
            ]
            endPoint DEF NOZZLE Solid {
              name "nozzle"
              translation 0 0 0.12
              children [
                # barrel along local +X, from the joint centre to x = 0.24
                Transform {
                  translation 0.12 0 0
                  rotation 0 0 1 -1.5708
                  children [
                    Shape {
                      appearance PBRAppearance {
                        baseColor 0.15 0.55 0.8
                        roughness 0.3
                        metalness 0.6
                      }
                      geometry Cylinder {
                        height 0.24
                        radius 0.03
                      }
                    }
                  ]
                }
              ]
              boundingObject Transform {
                translation 0.12 0 0
                children [
                  Box {
                    size 0.26 0.07 0.07
                  }
                ]
              }
              physics Physics {
                mass 0.2
                centerOfMass [
                  0.12 0 0
                ]
              }
            }
          }
        ]
        boundingObject Cylinder {
          height 0.06
          radius 0.09
        }
        physics Physics {
          mass 0.3
        }
      }
    }
  ]
}
